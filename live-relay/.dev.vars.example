# Copy to .dev.vars for `wrangler dev`. The fake publisher uses the same value.
LIVE_PUBLISH_TOKEN=dev-token
LIVE_WATCH_TOKEN=dev-watch
# Pages allowed to connect while developing (next dev, and a served static export).
SITE_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3099,http://127.0.0.1:3099
