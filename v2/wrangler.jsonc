{
  // Cloudflare Workers, static assets only: there is no `main`, so no Worker
  // code runs and every request is a free static-asset request. `next build`
  // writes the site to ./out (output: "export" in next.config.ts).
  "name": "cwru-motorsports",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./out",
    // /car is served from car.html; unknown paths get Next's 404.html.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
