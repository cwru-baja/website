{
  // Cloudflare Workers, static assets only: there is no `main`, so no Worker
  // code runs and every request is a free static-asset request. `next build`
  // writes the site to ./out (output: "export" in next.config.ts).
  "name": "baja-website",
  "compatibility_date": "2026-09-20",
  // The production workers.dev URL is off: master builds point next/image at
  // /cdn-cgi/image/, which only exists on cwrumotorsports.com, so every picture
  // would be broken there. Branch previews keep their URLs - they serve the
  // source files (see next.config.ts). A deploy resets the dashboard toggles to
  // these values.
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./out",
    // /car is served from car.html; unknown paths get Next's 404.html.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
