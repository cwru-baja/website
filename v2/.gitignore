# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch: render and export output, headless-browser profiles, QA captures.
# The Blender render/export scripts in artifacts/ stay tracked.
/artifacts/*
!/artifacts/*.py
!/artifacts/*.mjs
# The per-still K and lens-shift plan the portrait renders are made from.
!/artifacts/portrait-plan.json
!/artifacts/orbit-preview/
/artifacts/orbit-preview/*
!/artifacts/orbit-preview/*.py
/prof-*/
/.codex-tmp/
/public/renders-sr26/temp/
# Stand-in 4:5 frames from artifacts/make-portrait-standins.mjs; the real
# portrait renders replace them.
/public/renders-sr26/portrait/
/design-qa*.md
/*.png

# scripts/mobile-check.mjs output
/.mobile-check/

# Local-only portrait preview renders for /lab/portrait
/public/renders-sr26/portrait-preview/
